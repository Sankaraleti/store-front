# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon dashboard -> Connect).
# Use the pooled connection string for the app runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the browser auth client
NEXT_PUBLIC_APP_URL="http://localhost:3000"
